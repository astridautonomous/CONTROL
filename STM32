#include "main.h"
#include "i2c_slave_mode.h"

extern I2C_HandleTypeDef hi2c1;

#define RxSIZE 7
uint8_t RxData[RxSIZE];
uint8_t rxcount = 0;

int countAddr = 0;
int countrxcplt = 0;
int counterror = 0;

void HAL_I2C_ListenCpltCallback(I2C_HandleTypeDef *hi2c)
{
  HAL_I2C_EnableListen_IT(hi2c);
}

void HAL_I2C_AddrCallback(I2C_HandleTypeDef *hi2c, uint8_t TransferDirection, uint16_t AddrMatchCode)
{
	if(TransferDirection == I2C_DIRECTION_TRANSMIT)
	{
		countAddr++;
		HAL_I2C_Slave_Sequential_Receive_IT(hi2c, RxData+rxcount, 1, I2C_FIRST_AND_NEXT_FRAME);
	}
	else
	{
		Error_Handler();
	}
}

void HAL_I2C_SlaveRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
	rxcount++;
	if (rxcount >= RxSIZE) rxcount = 0;
	HAL_I2C_Slave_Seq_Receive_IT(hi2c, RxData, 1, I2C_FIRST_AND_NEXT_FRAME);
		countrxcplt++;
}

void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c)
{
	counterror++;
	HAL_I2C_EnableListen_IT(hi2c);
}

//this is for error handling situations
